---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui } from '../../i18n/ui';

const t = ui.es;
---

<BaseLayout title={`${t['site.name']} · ${t['home.title']}`} description={t['home.description']} lang="es" path="/es">
  <section class="max-w-2xl space-y-6">
    <p class="text-sm text-[var(--color-accent-data)]">{t['site.tagline']}</p>
    <h1 class="font-serif text-4xl font-semibold leading-tight">{t['site.name']}</h1>
    <p class="text-lg leading-relaxed">{t['home.intro']}</p>
    <div class="flex flex-wrap gap-4 pt-2">
      <a class="min-h-11 inline-flex items-center rounded border border-[var(--color-accent-data)] px-4 text-[var(--color-accent-data)]" href="/es/datos">{t['home.cta.data']}</a>
      <a class="min-h-11 inline-flex items-center rounded border border-[var(--color-accent-softskills)] px-4 text-[var(--color-accent-softskills)]" href="/es/soft-skills">{t['home.cta.softskills']}</a>
    </div>
  </section>
</BaseLayout>
