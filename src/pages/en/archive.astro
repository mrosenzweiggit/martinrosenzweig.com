---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveList from '../../components/ArchiveList.astro';
import { ui } from '../../i18n/ui';
import { routes } from '../../i18n/routes';

const t = ui.en;
---

<BaseLayout
  title={`${t['archive.title']} · ${t['site.name']}`}
  description={t['archive.description']}
  lang="en"
  path={routes.en.archive}
  alt={routes.es.archive}
>
  <header class="mb-10 max-w-2xl">
    <h1 class="font-serif text-4xl font-semibold">{t['archive.title']}</h1>
    <p class="mt-3 text-lg opacity-80">{t['archive.description']}</p>
  </header>
  <ArchiveList lang="en" />
</BaseLayout>
