---
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader';
import '../styles/global.css';
import { languages, ui, type Lang, type UIKey } from '../i18n/ui';
import { routes } from '../i18n/routes';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Ruta canónica de la página, sin dominio. */
  path: string;
  /** Ruta equivalente en el otro idioma, si existe. */
  alt?: string;
  noindex?: boolean;
}

const { title, description, lang, path, alt, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('https://martinrosenzweig.com');
const canonical = new URL(path, site).toString();
const altLang: Lang = lang === 'es' ? 'en' : 'es';
const altHref = alt ?? routes[altLang].home;
const t = (key: UIKey) => ui[lang][key];
const navItems: { key: UIKey; href: string }[] = [
  { key: 'nav.data', href: routes[lang].data },
  { key: 'nav.softskills', href: routes[lang].softskills },
  { key: 'nav.about', href: routes[lang].about },
  { key: 'nav.archive', href: routes[lang].archive },
  { key: 'nav.contact', href: routes[lang].contact },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.theme = saved;
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alt && <link rel="alternate" hreflang={lang} href={canonical} />}
    {alt && <link rel="alternate" hreflang={altLang} href={new URL(alt, site).toString()} />}
    {alt && <link rel="alternate" hreflang="x-default" href={new URL(lang === 'es' ? path : alt, site).toString()} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="min-h-dvh font-sans antialiased">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:p-2">
      {lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}
    </a>

    <header class="border-b border-[var(--color-border)]">
      <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-3">
        <a href={routes[lang].home} class="font-serif text-xl font-semibold">{t('site.name')}</a>

        <nav aria-label="Principal" class="hidden md:block">
          <ul class="flex gap-5 text-sm">
            {navItems.map((item) => (
              <li>
                <a class="inline-flex min-h-11 items-center underline-offset-4 hover:underline" href={item.href}>
                  {t(item.key)}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="flex items-center gap-1 text-sm">
          <a
            class="inline-flex min-h-11 items-center px-2 font-medium"
            href={altHref}
            hreflang={altLang}
            aria-label={`${t('lang.switch')}: ${languages[altLang]}`}
          >
            {languages[altLang]}
          </a>
          <button
            id="theme-toggle"
            type="button"
            class="inline-flex min-h-11 min-w-11 items-center justify-center rounded"
            aria-label={t('theme.toggle')}
          >
            <span aria-hidden="true">◐</span>
          </button>
          <details class="relative md:hidden">
            <summary class="inline-flex min-h-11 cursor-pointer list-none items-center px-2">{t('nav.menu')}</summary>
            <nav
              aria-label="Móvil"
              class="absolute right-0 z-10 mt-2 w-56 rounded border border-[var(--color-border)] bg-[var(--color-bg)] p-4 shadow-sm"
            >
              <ul class="flex flex-col gap-3 text-sm">
                {navItems.map((item) => (
                  <li>
                    <a class="inline-flex min-h-11 items-center" href={item.href}>{t(item.key)}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="contenido" class="mx-auto max-w-5xl px-5 py-12">
      <slot />
    </main>

    <footer class="mx-auto max-w-5xl border-t border-[var(--color-border)] px-5 py-8 text-sm opacity-80">
      <p>© {new Date().getFullYear()} {t('site.name')}. {t('footer.rights')}</p>
    </footer>

    <script>
      const root = document.documentElement;
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        const next = isDark ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>
