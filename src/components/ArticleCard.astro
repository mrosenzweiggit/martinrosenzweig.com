---
import { ui, type Lang } from '../i18n/ui';
import { sectionPath } from '../i18n/routes';
import { readingTime, type Entry } from '../lib/articles';

interface Props {
  entry: Entry;
  lang: Lang;
}

const { entry, lang } = Astro.props;
const { title, summary, slug, section, publishedAt } = entry.data;
const t = ui[lang];
const href = `${sectionPath(lang, section)}/${slug}`;
const accent = section === 'data' ? 'var(--color-accent-data)' : 'var(--color-accent-softskills)';
const date = publishedAt.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});
const minutes = readingTime((entry as { body?: string }).body);
---

<article class="group border-l-2 py-2 pl-5" style={`border-color: ${accent}`}>
  <p class="eyebrow" style={`color: ${accent}`}>
    {section === 'data' ? t['section.data'] : t['section.softskills']}
  </p>
  <h2 class="mt-3 font-serif text-2xl font-semibold leading-snug tracking-tight">
    <a class="underline-offset-4 decoration-2 group-hover:underline" href={href}>{title}</a>
  </h2>
  <p class="mt-3 leading-relaxed opacity-75">{summary}</p>
  <p class="mt-4 text-sm opacity-60">
    <time datetime={publishedAt.toISOString().slice(0, 10)}>{date}</time> · {minutes} {t['article.reading']}
  </p>
</article>
